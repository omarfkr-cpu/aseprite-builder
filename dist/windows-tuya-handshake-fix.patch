+
+export async function findTuyaByHandshake({ devId, localKey, protoVersion, candidates = [], timeoutMs = 2500, onAttempt }) {
+  const known = protoVersion ? String(protoVersion) : null;
+  const versions = known ? [known, ...HANDSHAKE_VERSIONS.filter((v) => v !== known)] : HANDSHAKE_VERSIONS;
+  for (const ip of candidates) {
+    for (const version of versions) {
+      const { identified, failure } = await identifyByHandshake({ devId, localKey, ip, version, timeoutMs });
