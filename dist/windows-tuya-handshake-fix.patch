+/**
+ * Manual fallback: the user types the bulb's LAN address. We prove it is the right device
+ * with a real handshake (trying every protocol version) and store ip + version on success.
+ */
+async function connectByIp(context, payload) {
+  const reply = (data) => $UD.sendToPropertyInspector({ cmd: 'connectResult', ...data }, context);
+  const ip = String(payload.ip || '').trim();
+  const record = registry.getDevice(payload.id);
+
+  if (!/^(\d{1,3}\.){3}\d{1,3}$/.test(ip) || ip.split('.').some((o) => Number(o) > 255)) {
+    reply({ ok: false, message: 'Enter the bulb address like 192.168.1.20.' });
+    return;
+  }
+  if (!record || record.kind !== 'tuya') {
+    reply({ ok: false, message: 'Pick the Tuya light in the Light list first.' });
+    return;
+  }
+  if (!record.localKey) {
+    reply({ ok: false, message: 'This light has no Tuya key yet — press "Get my Tuya keys" first.' });
+    return;
+  }
+
+  reply({ ok: null, message: `Trying ${ip} (this can take up to 20 seconds)…` });
+  const failures = [];
+  const hit = await findTuyaByHandshake({
+    devId: record.devId,
+    localKey: record.localKey,
+    protoVersion: record.protoVersion,
+    candidates: [ip],
+    timeoutMs: 4000,
+    onAttempt: ({ version, ok, failure }) => {
+      log(`${record.name}: manual handshake ${ip} v${version} → ${ok ? 'OK' : failure || 'no answer'}`, 'warn');
+      if (!ok) failures.push(`v${version}: ${failure || 'no answer'}`);
+    },
+  });
+
+  if (!hit) {
+    reply({ ok: false, message: `Could not connect to ${ip}. ${failures.join('; ')}` });
+    return;
+  }
+  registry.upsertDevice({ id: record.id, ip: hit.ip, protoVersion: hit.version });
+  manager.sync();
+  sendDevices(context);
+  renderAll();
+  reply({ ok: true, message: `Connected to ${record.name} at ${hit.ip} (protocol ${hit.version}). Press Identify to test it.` });
+  $UD.toast(`${record.name} found at ${hit.ip}`);
